#!/usr/bin/env python3
"""
bin/check-role — the release gate for a RasaOS role module (`role-<id>`).

  bin/check-role                                    check this repo; exit 1 on any problem
  RASA_SCHEMA_DIR=~/rAI/rasa-os/schema bin/check-role   also run the canonical rasa.json validator

Checks, each printed ok / FAIL:

  1. rasa.json is the role's: kind module, name rasa.module.role.<id>, source
     RasaOS/role-<id>, and rasa.role_id / rasa.role_version equal role.json's.
  2. One version everywhere: VERSION, rasa.json, plugin.json, the top
     CHANGELOG.md heading and README.md's **Version:** line.
  3. .claude-plugin/plugin.json names rasa-role-<id> and declares no hooks
     and no MCP servers.
  4. Nothing widens what a session may do. Tenant ADR
     2026-10-10-roles-are-element-modules D5 says only a person may load a
     widening Element, so there is no settings.json, .mcp.json or hooks/,
     and rasa.json permissions is []. A role's gate grants are in role.json
     and reach a session only through a role assignment a person publishes.
  5. role.json keeps galt's RoleSchema limits (bus-contract src/roles.ts),
     copied here by hand. galt re-checks it at publish. An optional `crew`
     block (tenant ADR 2026-10-28-one-role-list) says how a crew uses the
     role: tier member|lead|manager, the galt card name, and that tier's card
     header fields.
  6. prompt.md holds 1..20000 characters.
  7. No canon ELEMENT_CONTRACT §8 forbidden vocabulary.
  8. No secret-shaped strings (GitHub, OpenAI, Google, Slack and AWS tokens,
     private keys). The repo is public. This catches only the obvious
     shapes; it does not prove the repo is clean.
  9. The canonical validator (RasaOS/schema bin/validate) passes on
     rasa.json. It is SKIPPED unless RASA_SCHEMA_DIR is set, and a skip is
     not a pass.

Standard library only.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

ID_RE = re.compile(r"^[a-z][a-z0-9_-]{0,39}$")
FIELD_RE = re.compile(r"^[a-z][a-z0-9_]{0,39}$")
KIND_REF_RE = re.compile(r"^[a-z][a-z0-9_-]{0,29}\.[a-z][a-z0-9_-]{0,39}@[1-9][0-9]{0,5}$")
CAP_RE = re.compile(r"^[a-z][a-z0-9-]*(\.[a-z][a-z0-9-]*)*$")
SEMVER_RE = re.compile(r"^\d+\.\d+\.\d+$")
CONSUMERS = {"worker", "daemon"}
POWERS = {"session_end"}
GATE_ACTIONS = {"deploy", "rules", "data", "merge", "repo_create"}
GATE_ENVS = {"dev", "stage", "prod", "galt", "unknown", "*"}
AGENT_GRANTS = {"router_update", "merge", "deploy_release", "deploy_lower"}
ROLE_KEYS = {"id", "name", "summary", "version", "consumers", "knowledge", "takes", "kinds",
             "grants", "powers", "listens", "agent_grants", "model", "effort", "retired", "crew"}
CREW_COMMON = {"tier", "card", "placeholders", "tags", "when"}
CREW_KEYS = {"member": CREW_COMMON | {"writes", "claims", "board", "saves", "web", "stages"},
             "lead": CREW_COMMON | {"team", "finish", "standard", "stage-words", "settings"},
             "manager": CREW_COMMON}
TAKE_KEYS = {"kind", "requires", "optional", "include", "max_minutes", "proof"}
FORBIDDEN = ["MANIFEST.json", "foundation.json", "manifest contract", "bootstrap/"]
SECRET_RES = [re.compile(x) for x in (
    r"gh[pousr]_[A-Za-z0-9]{30,}", r"github_pat_[A-Za-z0-9_]{30,}", r"sk-[A-Za-z0-9_-]{20,}",
    r"AIza[0-9A-Za-z_-]{30,}", r"xox[abposr]-[A-Za-z0-9-]{10,}", r"AKIA[0-9A-Z]{16}",
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----")]
PROMPT_MAX = 20000

failed = 0


def report(n, title, problems):
    global failed
    if problems:
        failed += 1
        print(f"  {n}. FAIL {title}")
        for p in problems:
            print(f"       - {p}")
    else:
        print(f"  {n}. ok   {title}")


def load_json(rel):
    path = ROOT / rel
    if not path.is_file():
        return None, f"{rel} is missing"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except ValueError as e:
        return None, f"{rel} is not valid JSON ({e})"
    if not isinstance(value, dict):
        return None, f"{rel} must be a JSON object"
    return value, None


def strs(v):
    return isinstance(v, list) and all(isinstance(x, str) and x for x in v)


rasa, rasa_err = load_json("rasa.json")
role, role_err = load_json("role.json")
plugin, plugin_err = load_json(".claude-plugin/plugin.json")
rid = role.get("id") if role else None
if not isinstance(rid, str) or not ID_RE.match(rid):
    print(f"check-role: role.json has no usable id ({role_err or rid!r}); nothing else can be checked")
    sys.exit(1)

print(f"check-role: role-{rid}")

# 1 — rasa.json is the role's
p = [rasa_err] if rasa_err else []
if rasa:
    if rasa.get("kind") != "module":
        p.append(f"kind is {rasa.get('kind')!r}; a role is a module until canon writes kind: role")
    if rasa.get("name") != f"rasa.module.role.{rid}":
        p.append(f"name is {rasa.get('name')!r}; expected rasa.module.role.{rid}")
    if (rasa.get("source") or {}).get("repo") != f"https://github.com/RasaOS/role-{rid}":
        p.append(f"source.repo is not https://github.com/RasaOS/role-{rid}")
    meta = rasa.get("rasa") or {}
    if meta.get("role_id") != rid:
        p.append(f"rasa.role_id is {meta.get('role_id')!r}; role.json id is {rid!r}")
    if meta.get("role_version") != role.get("version"):
        p.append(f"rasa.role_version is {meta.get('role_version')!r}; role.json version is {role.get('version')!r}")
    for c in rasa.get("capabilities") or []:
        if not isinstance(c, str) or not CAP_RE.match(c):
            p.append(f"capability {c!r} is not a dotted lowercase name")
    if f"role.{rid}" not in (rasa.get("capabilities") or []):
        p.append(f"capabilities lacks role.{rid}")
report(1, "rasa.json is this role's", p)

# 2 — one version everywhere
p = []
version_file = (ROOT / "VERSION").read_text(encoding="utf-8").strip() if (ROOT / "VERSION").is_file() else None
versions = {"VERSION": version_file,
            "rasa.json": rasa.get("version") if rasa else None,
            "plugin.json": plugin.get("version") if plugin else None}
cl = ROOT / "CHANGELOG.md"
m = re.search(r"^## (\d+\.\d+\.\d+)\b", cl.read_text(encoding="utf-8"), re.M) if cl.is_file() else None
versions["CHANGELOG.md"] = m.group(1) if m else None
rd = ROOT / "README.md"
m = re.search(r"\*\*Version:\*\*\s*(\d+\.\d+\.\d+)", rd.read_text(encoding="utf-8")) if rd.is_file() else None
versions["README.md"] = m.group(1) if m else None
if not version_file or not SEMVER_RE.match(version_file):
    p.append(f"VERSION is {version_file!r}; expected MAJOR.MINOR.PATCH")
for where, v in versions.items():
    if v != version_file:
        p.append(f"{where} says {v!r}; VERSION says {version_file!r}")
report(2, f"one version ({version_file})", p)

# 3 — the plugin manifest
p = [plugin_err] if plugin_err else []
if plugin:
    if plugin.get("name") != f"rasa-role-{rid}":
        p.append(f"plugin.json name is {plugin.get('name')!r}; expected rasa-role-{rid}")
    for key in ("hooks", "mcpServers"):
        if plugin.get(key):
            p.append(f"plugin.json declares {key}: that widens what a session may do")
report(3, ".claude-plugin/plugin.json", p)

# 4 — nothing widens
p = []
for rel in ("settings.json", ".mcp.json", "hooks"):
    if (ROOT / rel).exists():
        p.append(f"{rel} exists: a widening Element can be loaded only by a person (D5)")
if rasa and rasa.get("permissions"):
    p.append("rasa.json permissions is not []: galt counts it as widening")
if rasa and rasa.get("grants"):
    p.append("rasa.json carries grants: a role's grants belong in role.json")
report(4, "nothing widens", p)

# 5 — role.json
p = []
prompt_text = (ROOT / "prompt.md").read_text(encoding="utf-8") if (ROOT / "prompt.md").is_file() else ""
for k in role:
    if k not in ROLE_KEYS:
        p.append(f"unknown key {k!r}")
if not isinstance(role.get("name"), str) or not 1 <= len(role["name"]) <= 80:
    p.append("name must be 1..80 characters")
if not isinstance(role.get("summary", ""), str) or len(role.get("summary", "")) > 200:
    p.append("summary must be at most 200 characters")
if not isinstance(role.get("version"), int) or isinstance(role.get("version"), bool) or role["version"] < 1:
    p.append("version must be an integer >= 1")
cons = role.get("consumers")
if not strs(cons) or not cons or not set(cons) <= CONSUMERS or len(set(cons)) != len(cons):
    p.append(f"consumers must be a non-empty list of {sorted(CONSUMERS)}, each once")
know = role.get("knowledge", [])
if not isinstance(know, list) or len(know) > 20 or not all(isinstance(x, str) and 1 <= len(x) <= 200 for x in know):
    p.append("knowledge must be at most 20 strings of 1..200 characters")
takes = role.get("takes", [])
if not isinstance(takes, list) or len(takes) > 20:
    p.append("takes must be a list of at most 20")
    takes = []
seen = set()
for i, t in enumerate(takes):
    if not isinstance(t, dict):
        p.append(f"takes[{i}] is not an object")
        continue
    for k in t:
        if k not in TAKE_KEYS:
            p.append(f"takes[{i}] has unknown key {k!r}")
    kind = t.get("kind")
    if not isinstance(kind, str) or not ID_RE.match(kind):
        p.append(f"takes[{i}].kind {kind!r} is not a kind id")
    elif kind in seen:
        p.append(f"takes[{i}].kind {kind!r} is taken twice")
    seen.add(kind)
    for lst in ("requires", "optional"):
        v = t.get(lst, [])
        if not isinstance(v, list) or len(v) > 10 or not all(isinstance(f, str) and FIELD_RE.match(f) for f in v) or len(set(v)) != len(v):
            p.append(f"takes[{i}].{lst} must be at most 10 distinct field names")
    if set(t.get("requires") or []) & set(t.get("optional") or []):
        p.append(f"takes[{i}] lists a field in both requires and optional")
    if len(t.get("include", "")) > 200:
        p.append(f"takes[{i}].include is over 200 characters")
    mm = t.get("max_minutes")
    if mm is not None and (not isinstance(mm, int) or not 1 <= mm <= 720):
        p.append(f"takes[{i}].max_minutes must be 1..720")
    if t.get("proof") not in (None, "required", "optional"):
        p.append(f"takes[{i}].proof must be required or optional")
kinds = role.get("kinds", [])
if not isinstance(kinds, list) or len(kinds) > 20 or not all(isinstance(k, str) and KIND_REF_RE.match(k) for k in kinds) or len(set(kinds)) != len(kinds):
    p.append("kinds must be at most 20 distinct <publisher>.<name>@<version> refs")
grants = role.get("grants", [])
if not isinstance(grants, list) or len(grants) > 30:
    p.append("grants must be a list of at most 30")
    grants = []
for i, g in enumerate(grants):
    if not isinstance(g, dict) or set(g) != {"action", "env", "repo"}:
        p.append(f"grants[{i}] must be exactly {{action, env, repo}}")
        continue
    if g["action"] not in GATE_ACTIONS:
        p.append(f"grants[{i}].action {g['action']!r} is not one of {sorted(GATE_ACTIONS)}")
    if g["env"] not in GATE_ENVS:
        p.append(f"grants[{i}].env {g['env']!r} is not one of {sorted(GATE_ENVS)}")
    if not isinstance(g["repo"], str) or not 1 <= len(g["repo"]) <= 64:
        p.append(f"grants[{i}].repo must be 1..64 characters")
powers = role.get("powers", [])
if not strs(powers) and powers != [] or not set(powers or []) <= POWERS or len(set(powers or [])) != len(powers or []):
    p.append(f"powers must be distinct values of {sorted(POWERS)}")
ag = role.get("agent_grants", [])
if not isinstance(ag, list) or not set(ag) <= AGENT_GRANTS:
    p.append(f"agent_grants must be values of {sorted(AGENT_GRANTS)}")
if "listens" in role and not isinstance(role["listens"], list):
    p.append("listens must be a list (galt checks each source at load)")
crew = role.get("crew")
if crew is not None:
    tier = crew.get("tier") if isinstance(crew, dict) else None
    if tier not in CREW_KEYS:
        p.append("crew.tier must be member, lead or manager")
    else:
        for k in crew:
            if k not in CREW_KEYS[tier]:
                p.append(f"crew has unknown key {k!r} for a {tier}")
        if not isinstance(crew.get("card"), str) or not re.match(r"^[a-z][a-z0-9-]*$", crew.get("card", "")):
            p.append("crew.card must be the galt card name (lowercase, dashes)")
        for k in ("writes", "saves", "web"):
            if k in crew and not isinstance(crew[k], bool):
                p.append(f"crew.{k} must be true or false")
        for k in ("claims", "stages", "tags", "team", "placeholders"):
            if k in crew and not (isinstance(crew[k], list) and all(isinstance(x, str) and x for x in crew[k])):
                p.append(f"crew.{k} must be a list of strings")
        if "finish" in crew and crew["finish"] not in ("pr", "branch"):
            p.append("crew.finish must be pr or branch")
        if "standard" in crew and crew["standard"] not in ("extend", "replace"):
            p.append("crew.standard must be extend or replace")
        for ph in crew.get("placeholders") or []:
            if "{" + ph + "}" not in prompt_text:
                p.append(f"crew.placeholders names {{{ph}}}, which prompt.md does not use")
report(5, f"role.json ({rid} v{role.get('version')})", p)

# 6 — prompt.md
p = []
pf = ROOT / "prompt.md"
prompt = pf.read_text(encoding="utf-8").strip("\n") if pf.is_file() else ""
if not 1 <= len(prompt) <= PROMPT_MAX:
    p.append(f"prompt.md is {len(prompt)} characters (1..{PROMPT_MAX})")
report(6, f"prompt.md ({len(prompt)} characters)", p)

# 7 — canon §8 vocabulary, and 8 — secret-shaped strings
p = []
secrets = []
try:
    files = subprocess.run(["git", "ls-files"], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
except (OSError, subprocess.CalledProcessError):
    files = [str(f.relative_to(ROOT)) for f in ROOT.rglob("*") if f.is_file() and ".git" not in f.parts]
for rel in files:
    if rel == "bin/check-role":
        continue
    try:
        text = (ROOT / rel).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        continue
    for term in FORBIDDEN:
        if term in text:
            p.append(f"{rel} uses {term!r}")
    for rx in SECRET_RES:
        if rx.search(text):
            secrets.append(f"{rel} holds something shaped like a secret ({rx.pattern[:12]}…): remove it and rotate it")
report(7, "canon §8 vocabulary", p)
report(8, "no secret-shaped strings (public repo)", secrets)

# 9 — the canonical validator
schema = os.environ.get("RASA_SCHEMA_DIR")
if not schema:
    print("  9. SKIP canonical validator (set RASA_SCHEMA_DIR to a RasaOS/schema checkout; a skip is not a pass)")
else:
    sdir = Path(schema).expanduser()
    py = sdir / ".venv" / "bin" / "python3"
    cmd = [str(py) if py.exists() else sys.executable, str(sdir / "bin" / "validate"), str(ROOT / "rasa.json")]
    r = subprocess.run(cmd, capture_output=True, text=True)
    report(9, "canonical validator PASS" if r.returncode == 0 else "canonical validator",
           [] if r.returncode == 0 else [ln for ln in (r.stdout + r.stderr).strip().splitlines()[-6:]])

print("check-role: " + ("GREEN" if failed == 0 else f"{failed} check(s) failed"))
sys.exit(1 if failed else 0)
